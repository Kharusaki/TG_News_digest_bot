# Токен Telegram-бота (выдаёт @BotFather)
BOT_TOKEN=

# Необязательно: прокси для api.telegram.org, если напрямую недоступен
TELEGRAM_PROXY=http://127.0.0.1:10809

# Основной провайдер LLM по ТЗ: gemini | proxy
LLM_PROVIDER=gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash

# Fallback: OpenAI-совместимый ProxyAPI.ru (используется, если GEMINI_API_KEY пуст)
PROXY_API_KEY=
PROXY_BASE_URL=https://api.proxyapi.ru
PROXY_MODEL=openai/gpt-4.1-mini

# Локально Redis на localhost, внутри Docker сервис называется redis
REDIS_URL=redis://127.0.0.1:6379/0
DB_PATH=bot.db

# Свежесть материалов: новости/аудит/технологии и отдельно вакансии
DIGEST_MAX_AGE_DAYS=3
DIGEST_MAX_AGE_DAYS_JOBS=14

# Ежедневный сбор всех тем (по московскому времени). Рассылка идёт в начале
# выбранного каждым пользователем часа и только из готового кеша.
DIGEST_COLLECT_TIME=08:30
